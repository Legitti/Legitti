<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#2D2D2D</color>
    <color name="gold">#EDB246</color>
    <color name="icon_background">#0E0E0E</color>
    <color name="muted">#C8C3B8</color>
    <color name="text">#F4F1EA</color>
    <string name="app_name">Legitti</string>
    <string name="downloading">Downloading…</string>
    <string name="offline_body">Check your internet and try again.</string>
    <string name="offline_title">No connection</string>
    <string name="retry">Try again</string>
    <style name="Theme.Legitti" parent="Theme.AppCompat.NoActionBar">
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">@color/gold</item>
        <item name="colorAccent">@color/gold</item>
        <item name="android:colorAccent">@color/gold</item>
    </style>
    <style name="Theme.Legitti.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Legitti</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>
</resources>